---
// ArticleLayout.astro: 帮助中心文章布局（排查步骤与网络知识）
// 文档式布局：正文栏约 46rem；桌面端本文目录固定在右侧并高亮当前小节，手机端目录在正文上方。
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import CtaLanes from '../components/CtaLanes.astro';
import { type ArticleItem, ARTICLES_DATA } from '../data/articles';
import { SITE_CONFIG } from '../config/site';
import { breadcrumbJsonLd } from '../utils/schema';
import { extractTableOfContents, normalizeArticleContent } from '../utils/markdown';
import { categoryIcon } from '../utils/topic';

interface Props {
  article: ArticleItem;
}

const { article } = Astro.props;

const pageUrl = `${SITE_CONFIG.siteUrl}${article.path}`;
// <title>：标题已含品牌时直接使用，否则加「｜灵动云」
const metaTitle = article.title.includes('灵动云') ? article.title : `${article.title}｜灵动云`;

const relatedArticles = article.relatedSlugs
  .map((slug) => ARTICLES_DATA.find((a) => a.slug === slug))
  .filter((a): a is ArticleItem => Boolean(a));

const tocItems = extractTableOfContents(normalizeArticleContent(article.content));

const breadcrumbs = [
  { name: '帮助中心', path: '/' },
  { name: article.title, path: article.path },
];

const articleSchema = {
  '@type': article.schemaType,
  '@id': `${pageUrl}#article`,
  headline: article.title,
  description: article.description,
  inLanguage: 'zh-CN',
  datePublished: article.publishDate,
  dateModified: article.modifyDate,
  author: { '@id': SITE_CONFIG.orgId },
  publisher: { '@id': SITE_CONFIG.orgId },
  mainEntityOfPage: pageUrl,
  isPartOf: { '@id': SITE_CONFIG.websiteId },
  image: SITE_CONFIG.ogImage,
};
---

<BaseLayout
  title={metaTitle}
  description={article.description}
  canonicalPath={article.path}
  ogType="article"
  modifiedTime={article.modifyDate}
  jsonLd={[articleSchema, breadcrumbJsonLd(breadcrumbs)]}
>
  <div class="wrap pt-4 pb-20 sm:pt-6 sm:pb-24">
    <Breadcrumbs items={breadcrumbs} />

    <div class="article-grid mt-4 sm:mt-6">
      <header>
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-[0.8125rem] text-ink-3">
          <span class="chip">
            <Icon name={categoryIcon(article.category)} />
            {article.category}
          </span>
          <span class="tabular-nums">更新于 {article.modifyDate}</span>
          <span aria-hidden="true">·</span>
          <span>阅读约 {article.readTime}</span>
        </div>

        <h1 class="article-title mt-5">{article.title}</h1>

        <p class="article-standfirst">{article.description}</p>
      </header>

      {tocItems.length > 2 && (
        <nav aria-label="文章目录大纲" class="toc glass">
          <div class="toc-title">
            <Icon name="list" />
            <span>本文目录</span>
          </div>
          <ol class="toc-list">
            {tocItems.map((item, idx) => (
              <li>
                <a href={`#${item.id}`} class="toc-link">
                  <span class="toc-num">{idx + 1}</span>
                  <span>{item.title}</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )}

      <article class="mt-10">
        <slot />
      </article>

      <!-- 还没解决：联系支持 -->
      <section class="cta-panel glass mt-16 !text-left">
        <CtaLanes side="right" />
        <div class="flex flex-col gap-5 sm:flex-row sm:gap-6">
          <span class="icon-tile"><Icon name="chat" /></span>
          <div class="min-w-0">
            <h2 class="text-xl font-semibold text-ink sm:text-2xl">还没有解决？</h2>
            <p class="mt-2 max-w-xl text-[0.9375rem] leading-[1.85] text-ink-2">
              可以打开在线客服（Crisp 对话）直接描述情况，或登录用户中心提交工单。提问时附上设备、客户端版本和报错信息，截图请遮住订阅链接。
            </p>
            <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
              <button type="button" data-open-crisp class="btn btn-primary">
                <Icon name="chat" />
                联系在线客服
              </button>
              <a href={SITE_CONFIG.registerUrl} target="_blank" rel="noopener" class="btn btn-secondary">
                登录用户中心提交工单
              </a>
              {article.slug !== 'troubleshooting' && (
                <a href="/guides/troubleshooting/" class="btn btn-secondary">
                  连接问题排查步骤
                </a>
              )}
            </div>
          </div>
        </div>
      </section>

      {relatedArticles.length > 0 && (
        <section class="mt-16">
          <h2 class="mb-5 text-xl font-semibold text-ink">相关文章</h2>
          <ul class="kb-list glass" role="list">
            {relatedArticles.map((rel) => (
              <li>
                <a href={rel.path} class="kb-row group">
                  <span class="icon-tile icon-tile-sm mt-0.5"><Icon name={categoryIcon(rel.category)} /></span>
                  <div class="min-w-0 flex-1">
                    <span class="block text-[0.8125rem] font-medium text-lilac">{rel.category}</span>
                    <h3 class="mt-1 text-base font-semibold leading-[1.55] text-ink">{rel.title}</h3>
                    <p class="mt-1.5 text-sm leading-[1.8] text-ink-2">{rel.description}</p>
                    <span class="more mt-3">
                      <span>阅读此篇</span>
                      <Icon name="arrow-right" />
                    </span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </div>
</BaseLayout>

<script>
  // 本文目录：滚动时高亮当前小节（只改样式状态，不影响链接本身）
  function setupTocSpy() {
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc-link'));
    if (links.length === 0) return;
    const pairs = links
      .map((link) => {
        const id = decodeURIComponent(link.hash.slice(1));
        const el = document.getElementById(id);
        return el ? { link, el } : null;
      })
      .filter((p): p is { link: HTMLAnchorElement; el: HTMLElement } => p !== null);

    let ticking = false;
    function update() {
      ticking = false;
      let current: HTMLAnchorElement | null = null;
      for (const p of pairs) {
        if (p.el.getBoundingClientRect().top <= 140) current = p.link;
        else break;
      }
      links.forEach((l) => {
        if (l === current) l.setAttribute('aria-current', 'true');
        else l.removeAttribute('aria-current');
      });
    }
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true }
    );
    update();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupTocSpy);
  } else {
    setupTocSpy();
  }
</script>
