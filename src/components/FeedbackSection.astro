---
// FeedbackSection.astro: 灵动云 官方客服与用户反馈专区
// 直连官方线路检测入口与 Crisp 实时在线客服系统
import { SITE_CONFIG } from '../config/site';
---

<section id="feedback" class="py-20 relative z-10 scroll-mt-16">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="p-8 sm:p-10 rounded-3xl bg-[#160C32]/85 border border-[#8B40FF]/30 backdrop-blur-md shadow-[0_15px_40px_-10px_rgba(0,0,0,0.5)]">
      <!-- Section Header -->
      <div class="text-center max-w-2xl mx-auto mb-10">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#588DFF]/15 border border-[#588DFF]/30 text-xs font-semibold text-[#588DFF] mb-3">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>官方直连客服 · 7×24 持续打磨服务</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white mb-3">
          灵动云 用户反馈与客服中心
        </h2>
        <p class="text-xs sm:text-sm text-[#D4C8ED]/85 leading-relaxed">
          我们坚持不编造虚假评价与夸大评分。如您在使用过程中遇到任何节点连接、套餐选择、客户端配置或账号疑问，欢迎通过下方官方通道直接与 Crisp 在线客服建立对话，或进入官网客服区提交技术工单。
        </p>
      </div>

      <!-- Two Column Layout: Official Dashboard & Crisp Live Chat -->
      <div class="grid grid-cols-1 md:grid-cols-5 gap-8">
        <!-- Left: Official Dashboard & Line Detection (2 cols) -->
        <div class="md:col-span-2 space-y-5 text-xs sm:text-sm text-[#D4C8ED]/85 border-b md:border-b-0 md:border-r border-[#8B40FF]/20 pb-6 md:pb-0 md:pr-6 flex flex-col justify-between">
          <div class="space-y-4">
            <div>
              <h3 class="text-base font-bold text-white mb-2 flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-[#8B40FF]"></span>
                官方售后与工单中心
              </h3>
              <p class="text-xs text-[#D4C8ED]/75 leading-relaxed">
                如遇订阅地址同步失败、紧急故障或退订工单，推荐前往灵动云官网客服区，系统将自动进行线路检测并跳转至最快节点控制台。
              </p>
            </div>

            <div class="p-4 rounded-xl bg-[#09071C]/90 border border-[#8B40FF]/25 space-y-2">
              <div class="flex items-center justify-between text-xs font-semibold text-white">
                <span>官网客服渠道</span>
                <span class="text-[10px] px-2 py-0.5 rounded bg-[#8B40FF]/25 text-[#B87AFF]">线路测速调度</span>
              </div>
              <p class="text-xs text-[#D4C8ED]/75 leading-relaxed">
                1. 线路自动检测与最优登录入口<br />
                2. 登录用户后台发起 1 对 1 技术工单<br />
                3. 官方承诺：24 小时内工单响应排查
              </p>
            </div>
          </div>

          <div class="pt-2">
            <a
              href={SITE_CONFIG.registerUrl}
              target="_blank"
              rel="sponsored noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 py-3 px-4 rounded-xl font-semibold text-xs text-white bg-[#160C32] hover:bg-[#8B40FF]/25 border border-[#8B40FF]/40 hover:border-[#C15BFF] transition-all group"
            >
              <span>跳转进入官网客服区（线路检测）</span>
              <svg class="w-3.5 h-3.5 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Right: Crisp Live Chat Integration (3 cols) -->
        <div class="md:col-span-3 space-y-4">
          <div class="p-5 rounded-2xl bg-[#09071C]/90 border border-[#8B40FF]/30 space-y-4">
            <div class="flex items-center justify-between border-b border-[#8B40FF]/20 pb-3">
              <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-lg bg-[#588DFF]/20 text-[#588DFF] flex items-center justify-center font-bold text-sm">
                  <svg class="w-4 h-4 text-[#588DFF]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                  </svg>
                </div>
                <div>
                  <h4 class="text-sm font-bold text-white flex items-center gap-2">
                    <span>Crisp 在线客服直连</span>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 mr-1 animate-ping"></span>
                      客服在线
                    </span>
                  </h4>
                  <span class="text-[11px] text-[#D4C8ED]/60">有问题随时发消息，技术客服即时对接</span>
                </div>
              </div>
            </div>

            <!-- Quick question / message form -->
            <form id="crisp-trigger-form" class="space-y-3">
              <div>
                <label for="crisp-question" class="block text-xs font-medium text-[#D4C8ED] mb-1.5">
                  输入您的问题或建议（点击后直接唤起 Crisp 对话）：
                </label>
                <textarea
                  id="crisp-question"
                  rows="3"
                  placeholder="例如：请问我的 Clash 订阅更新超时怎么解决？/ 套餐到期如何续费？"
                  class="w-full px-3.5 py-2.5 rounded-xl bg-[#160C32]/90 border border-[#8B40FF]/30 text-white text-xs sm:text-sm placeholder-[#D4C8ED]/40 focus:outline-none focus:border-[#C15BFF] transition-colors resize-none"
                ></textarea>
              </div>

              <div class="flex flex-col sm:flex-row gap-2.5">
                <button
                  type="submit"
                  class="flex-1 py-3 px-4 rounded-xl font-semibold text-xs sm:text-sm text-white bg-gradient-to-r from-[#8B40FF] via-[#A855F7] to-[#588DFF] hover:shadow-[0_0_22px_rgba(139,64,255,0.5)] transition-all duration-300 flex items-center justify-center gap-2"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                  <span>立即与 Crisp 客服建立连接</span>
                </button>

                <a
                  href={SITE_CONFIG.crispChatUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="py-3 px-4 rounded-xl font-medium text-xs text-[#D4C8ED] hover:text-white bg-[#160C32] hover:bg-[#8B40FF]/20 border border-[#8B40FF]/30 transition-all text-center flex items-center justify-center gap-1.5"
                  title="在新窗口打开独立 Crisp 聊天页面"
                >
                  <span>新窗口打开</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              </div>
            </form>

            <div class="pt-2 border-t border-[#8B40FF]/15 flex items-center justify-between text-[11px] text-[#D4C8ED]/60">
              <span>运行于 Crisp 官方客户沟通平台</span>
              <span>支持全平台桌面与移动端即时交互</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function setupCrispConnect() {
    const triggerForm = document.getElementById('crisp-trigger-form');
    const questionInput = document.getElementById('crisp-question') as HTMLTextAreaElement | null;

    function openCrispChat(initialMessage?: string) {
      if (typeof window !== 'undefined') {
        const crisp = (window as any).$crisp;
        if (crisp && typeof crisp.push === 'function') {
          // If there is an initial message, send it to Crisp chat
          if (initialMessage && initialMessage.trim()) {
            crisp.push(['do', 'message:send', ['text', initialMessage.trim()]]);
          }
          // Open the Crisp chat box
          crisp.push(['do', 'chat:open']);
          return;
        }
      }
      // Fallback if script blocked: open direct Crisp chat URL in new window
      const fallbackUrl = 'https://go.crisp.chat/chat/embed/?website_id=8bffea93-cf2b-46e3-835e-302ed40c86fa';
      window.open(fallbackUrl, '_blank', 'noopener,noreferrer');
    }

    if (triggerForm) {
      triggerForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const msg = questionInput?.value || '';
        openCrispChat(msg);
      });
    }

    // Support footer/external crisp buttons if any
    const footerBtn = document.getElementById('footer-crisp-btn');
    footerBtn?.addEventListener('click', () => openCrispChat());
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupCrispConnect);
  } else {
    setupCrispConnect();
  }
</script>
