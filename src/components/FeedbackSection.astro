---
// FeedbackSection.astro: 在线客服与工单
// 两个支持渠道：本站的在线客服（Crisp 对话）与用户中心工单。不写响应时间、不写全天候承诺。
import Icon from './Icon.astro';
import { SITE_CONFIG } from '../config/site';
---

<section id="support" class="section">
  <div class="wrap">
    <div class="section-head">
      <div class="kicker">
        <span>联系支持</span>
      </div>
      <h2 class="section-title">在线客服与工单</h2>
      <p class="section-lead">
        照着排查步骤仍然解决不了，或者需要领取订阅链接，可以通过两种方式联系灵动云：本站的在线客服（Crisp 对话），或登录用户中心提交工单。Clash、通用、小火箭三种订阅链接都要向客服领取，在下面写明设备和所用客户端，再打开对话即可；连接问题、客户端设置也适合先问在线客服；账户、订单、续费这类需要核对账户信息的问题，建议提交工单。
      </p>
    </div>

    <div class="support-grid">
      <!-- Crisp live chat -->
      <div class="support-card glass">
        <div class="support-card-head">
          <span class="icon-tile"><Icon name="chat" /></span>
          <div>
            <h3 class="text-lg font-semibold leading-snug text-ink">在线客服（Crisp 对话）</h3>
            <p class="mt-1 text-sm leading-relaxed text-ink-3">点击页面右下角的客服图标，或在下面写下问题后打开对话。</p>
          </div>
        </div>

        <form id="crisp-trigger-form" class="flex flex-col gap-3">
          <label for="crisp-question" class="text-sm font-medium text-ink-2">
            你的问题（提交后会作为第一条消息发到对话中）
          </label>
          <textarea
            id="crisp-question"
            rows="3"
            placeholder="例如：Clash 更新订阅时提示下载失败，已经换过网络，用的是 Windows 11。"
            class="field resize-none"
          ></textarea>

          <div class="flex flex-col gap-2.5 sm:flex-row">
            <button type="submit" class="btn btn-primary flex-1">
              <Icon name="chat" />
              <span>打开在线客服对话</span>
            </button>
            <a
              href={SITE_CONFIG.crispChatUrl}
              target="_blank"
              rel="noopener"
              class="btn btn-secondary"
              title="在新窗口打开 Crisp 聊天页面"
            >
              <span>在新窗口打开</span>
              <Icon name="external" />
            </a>
          </div>
        </form>

        <div class="callout callout-secure">
          <Icon name="shield-check" class="callout-icon" />
          <p class="callout-body">
            <span class="callout-label">安全提示</span>
            请不要在对话中发送完整的订阅链接，它相当于账户凭证。
          </p>
        </div>
      </div>

      <!-- Ticket in user center -->
      <div class="support-card glass justify-between">
        <div class="flex flex-col gap-4">
          <div class="support-card-head">
            <span class="icon-tile"><Icon name="ticket" /></span>
            <div>
              <h3 class="text-lg font-semibold leading-snug text-ink">用户中心工单</h3>
              <p class="mt-1 text-sm leading-relaxed text-ink-3">适合账户、订单、续费等问题。</p>
            </div>
          </div>
          <p class="text-[0.9375rem] leading-[1.85] text-ink-2">
            登录用户中心后，在工单页面写明问题并提交，处理进度也在那里查看。用户中心同时用于查看套餐状态、剩余流量和重置订阅。
          </p>
        </div>
        <a href={SITE_CONFIG.registerUrl} target="_blank" rel="noopener" class="btn btn-secondary btn-lg w-full">
          <span>登录用户中心提交工单</span>
          <Icon name="external" />
        </a>
      </div>
    </div>

    <!-- What to include -->
    <div class="glass mt-4 rounded-card p-6 sm:p-7 lg:mt-5">
      <h3 class="mb-4 text-base font-semibold text-ink">提问前准备好这些信息，能更快定位问题</h3>
      <ul class="check-list" role="list">
        <li><Icon name="check" /><span>设备和系统版本，例如 Windows 11、iOS 18</span></li>
        <li><Icon name="check" /><span>客户端名称和版本号</span></li>
        <li><Icon name="check" /><span>出现问题的大致时间和报错提示（截图时遮住订阅链接）</span></li>
        <li><Icon name="check" /><span>已经尝试过的排查步骤</span></li>
      </ul>
    </div>
  </div>
</section>

<script>
  function setupCrispForm() {
    const form = document.getElementById('crisp-trigger-form');
    const questionInput = document.getElementById('crisp-question') as HTMLTextAreaElement | null;
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const open = (window as unknown as { ldyOpenCrisp?: (msg?: string) => void }).ldyOpenCrisp;
      const msg = questionInput?.value || '';
      if (typeof open === 'function') {
        open(msg);
        if (questionInput) questionInput.value = '';
      } else {
        window.open('https://go.crisp.chat/chat/embed/?website_id=8bffea93-cf2b-46e3-835e-302ed40c86fa', '_blank', 'noopener');
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupCrispForm);
  } else {
    setupCrispForm();
  }
</script>
