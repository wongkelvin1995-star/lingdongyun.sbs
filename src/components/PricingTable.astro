---
// PricingTable.astro: 灵动云九款套餐完整展示组件
import { PLANS_DATA, PLAN_CATEGORIES } from '../data/plans';
import { SITE_CONFIG } from '../config/site';
---

<section id="pricing" class="py-24 relative z-10 scroll-mt-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#8B40FF]/15 border border-[#8B40FF]/30 text-xs font-semibold text-[#B87AFF] mb-4">
        <span class="w-2 h-2 rounded-full bg-[#C15BFF] animate-pulse"></span>
        <span>全阶梯资费方案 · 真实透明无套路</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white mb-4">
        选择适合你的 <span class="bg-gradient-to-r from-[#C15BFF] via-[#8B40FF] to-[#588DFF] bg-clip-text text-transparent">灵动云套餐</span>
      </h2>
      <p class="text-base sm:text-lg text-[#D4C8ED]/85 leading-relaxed">
        涵盖月付、超值年付、不限时一次性流量包与至尊私人定制方案。所有套餐均接入高品质 BGP 专线与标准协议，支持随时升级调整。
      </p>
    </div>

    <!-- Category Filter Tabs -->
    <div class="flex items-center justify-center mb-12">
      <div class="inline-flex p-1.5 rounded-2xl bg-[#160C32]/90 border border-[#8B40FF]/30 backdrop-blur-md shadow-lg overflow-x-auto max-w-full">
        {PLAN_CATEGORIES.map((cat, index) => (
          <button
            type="button"
            data-category={cat.id}
            class={`category-tab-btn px-4 sm:px-5 py-2 sm:py-2.5 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-300 whitespace-nowrap ${
              index === 0
                ? 'bg-gradient-to-r from-[#8B40FF] to-[#588DFF] text-white shadow-[0_0_15px_rgba(139,64,255,0.4)]'
                : 'text-[#D4C8ED] hover:text-white hover:bg-[#8B40FF]/20'
            }`}
          >
            {cat.label}
          </button>
        ))}
      </div>
    </div>

    <!-- Plans Grid -->
    <div id="plans-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 sm:gap-8">
      {PLANS_DATA.map((plan) => {
        const isCustom = plan.category === 'custom';
        return (
          <div
            data-plan-card
            data-plan-cat={plan.category}
            class={`plan-card relative rounded-2xl p-6 sm:p-7 flex flex-col justify-between transition-all duration-300 ${
              isCustom
                ? 'md:col-span-2 lg:col-span-3 xl:col-span-4 bg-gradient-to-br from-[#160C32]/95 via-[#23114a]/90 to-[#09071C] border-2 border-[#C15BFF]/50 shadow-[0_0_35px_rgba(193,91,255,0.25)]'
                : plan.popular
                ? 'bg-[#160C32]/90 border-2 border-[#8B40FF] shadow-[0_0_30px_rgba(139,64,255,0.25)]'
                : 'bg-[#160C32]/70 border border-[#8B40FF]/25 hover:border-[#B87AFF]/60 shadow-[0_8px_25px_rgba(0,0,0,0.3)]'
            } hover:-translate-y-1.5`}
          >
            {/* Popular / Highlight Badge */}
            {plan.highlight && (
              <div class="absolute -top-3.5 right-6 px-3 py-0.5 rounded-full text-[11px] font-bold tracking-wide uppercase shadow-sm bg-gradient-to-r from-[#C15BFF] to-[#8B40FF] text-white">
                {plan.highlight}
              </div>
            )}

            <div>
              <!-- Plan Header -->
              <div class="mb-5">
                <h3 class="text-xl font-bold text-white tracking-tight flex items-center justify-between">
                  <span>{plan.name}</span>
                  <span class="text-xs px-2.5 py-1 rounded-md bg-[#8B40FF]/20 text-[#B87AFF] font-mono font-medium">
                    {plan.cycle}
                  </span>
                </h3>
                <p class="text-xs text-[#D4C8ED]/75 mt-2 line-clamp-2 min-h-[32px]">
                  {plan.summary}
                </p>
              </div>

              <!-- Price Box -->
              <div class="py-4 my-2 border-y border-[#8B40FF]/20 flex items-baseline justify-between">
                <div>
                  <span class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
                    {plan.price}
                  </span>
                  <span class="text-xs text-[#D4C8ED]/70 ml-1.5">
                    / {plan.cycle}
                  </span>
                </div>
                <div class="text-right">
                  <span class="text-sm sm:text-base font-bold text-[#588DFF]">
                    {plan.traffic}
                  </span>
                  <span class="block text-[10px] text-[#D4C8ED]/60">高速数据额度</span>
                </div>
              </div>

              <!-- Key Features List -->
              <ul class="my-5 space-y-2.5 text-xs sm:text-sm text-[#D4C8ED]">
                {plan.features.slice(0, 4).map((feat) => (
                  <li class="flex items-start gap-2">
                    <svg class="w-4 h-4 text-[#588DFF] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>{feat}</span>
                  </li>
                ))}
              </ul>

              <!-- Expandable Technical Details (Summary + Details) -->
              <div class="my-3">
                <button
                  type="button"
                  class="toggle-details-btn text-xs text-[#B87AFF] hover:text-[#C15BFF] font-medium flex items-center gap-1 focus:outline-none py-1"
                  aria-expanded="false"
                >
                  <span class="btn-text">展开更多技术规格</span>
                  <svg class="w-3.5 h-3.5 transform transition-transform duration-200 arrow-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </button>

                <div class="details-panel hidden mt-3 p-3.5 rounded-xl bg-[#09071C]/80 border border-[#8B40FF]/25 text-xs space-y-2 text-[#D4C8ED]/85">
                  <p><strong class="text-white">协议支持：</strong>{plan.details.protocol}</p>
                  <p><strong class="text-white">线路类型：</strong>{plan.details.lineType}</p>
                  <p><strong class="text-white">流媒体：</strong>{plan.details.mediaSupport}</p>
                  <p><strong class="text-white">AI 工具：</strong>{plan.details.aiSupport}</p>
                  <p><strong class="text-white">设备支持：</strong>{plan.details.devices}</p>
                  <p><strong class="text-white">流量清零：</strong>{plan.details.resetCycle}</p>
                  <p><strong class="text-white">适用画像：</strong>{plan.details.suitability}</p>
                </div>
              </div>
            </div>

            <!-- CTA Order Button (Unified Register URL) -->
            <div class="pt-5 mt-auto">
              <a
                href={SITE_CONFIG.registerUrl}
                target="_blank"
                rel="sponsored noopener noreferrer"
                class={`w-full py-3 px-4 rounded-xl text-center text-sm font-semibold flex items-center justify-center gap-2 transition-all duration-300 shadow-md ${
                  plan.popular || isCustom
                    ? 'bg-gradient-to-r from-[#8B40FF] via-[#C15BFF] to-[#588DFF] text-white hover:shadow-[0_0_25px_rgba(139,64,255,0.6)] hover:brightness-110'
                    : 'bg-[#8B40FF]/25 hover:bg-[#8B40FF]/40 text-white border border-[#8B40FF]/40 hover:border-[#8B40FF]'
                }`}
              >
                <span>立即注册订购</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Official Billing Notice -->
    <div class="mt-12 p-4 sm:p-5 rounded-2xl bg-[#160C32]/60 border border-[#8B40FF]/20 text-xs text-[#D4C8ED]/75 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-[#588DFF] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>
          <strong>周期说明：</strong>月付套餐按月计费；年付方案全年有效并按月下发流量；一次性流量包随用随扣不设月度清零。其他结算周期均以注册控制台实际结算页面为准。
        </span>
      </div>
      <a href="/guides/lingdongyun-plans/" class="text-[#B87AFF] hover:underline whitespace-nowrap font-medium">
        阅读套餐详细选购指南 →
      </a>
    </div>
  </div>
</section>

<script>
  function setupPricingInteractions() {
    // 1. Category Tab Filter
    const tabBtns = document.querySelectorAll<HTMLButtonElement>('.category-tab-btn');
    const cards = document.querySelectorAll<HTMLElement>('[data-plan-card]');

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetCategory = btn.getAttribute('data-category');

        // Update active tab styles
        tabBtns.forEach((b) => {
          b.classList.remove('bg-gradient-to-r', 'from-[#8B40FF]', 'to-[#588DFF]', 'text-white', 'shadow-[0_0_15px_rgba(139,64,255,0.4)]');
          b.classList.add('text-[#D4C8ED]');
        });
        btn.classList.add('bg-gradient-to-r', 'from-[#8B40FF]', 'to-[#588DFF]', 'text-white', 'shadow-[0_0_15px_rgba(139,64,255,0.4)]');
        btn.classList.remove('text-[#D4C8ED]');

        // Filter cards
        cards.forEach((card) => {
          const cardCat = card.getAttribute('data-plan-cat');
          if (targetCategory === 'all' || cardCat === targetCategory) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });

    // 2. Expand/Collapse Details
    const toggleBtns = document.querySelectorAll<HTMLButtonElement>('.toggle-details-btn');
    toggleBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const isExpanded = btn.getAttribute('aria-expanded') === 'true';
        const panel = btn.nextElementSibling as HTMLElement;
        const textSpan = btn.querySelector('.btn-text');
        const arrow = btn.querySelector('.arrow-icon');

        btn.setAttribute('aria-expanded', String(!isExpanded));
        if (panel) {
          panel.classList.toggle('hidden');
        }
        if (textSpan) {
          textSpan.textContent = isExpanded ? '展开更多技术规格' : '收起技术规格';
        }
        if (arrow) {
          arrow.classList.toggle('rotate-180');
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupPricingInteractions);
  } else {
    setupPricingInteractions();
  }
</script>
