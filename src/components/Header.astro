---
// Header.astro: 灵动云官方顶部导航栏
import { SITE_CONFIG } from '../config/site';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<header class="sticky top-0 z-50 w-full bg-[#09071C]/85 backdrop-blur-md border-b border-[#8B40FF]/20 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-[#8B40FF] rounded-lg p-1" aria-label="灵动云官网首页">
      <!-- Brand Tech Cloud & Network Nodes Icon -->
      <div class="relative w-11 h-11 rounded-xl bg-gradient-to-br from-[#8B40FF]/30 to-[#588DFF]/20 p-[1.5px] border border-[#8B40FF]/40 shadow-[0_0_15px_rgba(139,64,255,0.3)] group-hover:shadow-[0_0_22px_rgba(193,91,255,0.6)] group-hover:border-[#C15BFF] transition-all duration-300 flex items-center justify-center overflow-hidden">
        <svg class="w-7 h-7" viewBox="0 0 64 64" fill="none">
          <defs>
            <linearGradient id="logoGrad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#C15BFF" />
              <stop offset="50%" stop-color="#8B40FF" />
              <stop offset="100%" stop-color="#588DFF" />
            </linearGradient>
          </defs>
          <path d="M22 38h20a8 8 0 0 0 2-15.7A10 10 0 0 0 25.5 19 8 8 0 0 0 20 28.5 7 7 0 0 0 22 38z" fill="url(#logoGrad)" opacity="0.9" />
          <ellipse cx="32" cy="34" rx="20" ry="8" stroke="#588DFF" stroke-width="1.8" stroke-dasharray="4 3" opacity="0.8" transform="rotate(-15 32 34)" />
          <circle cx="21" cy="28" r="2.5" fill="#FFFFFF" />
          <circle cx="32" cy="22" r="2.5" fill="#FFFFFF" />
          <circle cx="41" cy="31" r="2.5" fill="#FFFFFF" />
          <line x1="21" y1="28" x2="32" y2="22" stroke="#FFFFFF" stroke-width="1.2" opacity="0.7" />
          <line x1="32" y1="22" x2="41" y2="31" stroke="#FFFFFF" stroke-width="1.2" opacity="0.7" />
        </svg>
      </div>

      <div class="flex flex-col">
        <span class="text-xl font-bold tracking-tight bg-gradient-to-r from-white via-[#D4C8ED] to-white bg-clip-text text-transparent group-hover:from-white group-hover:to-[#C15BFF] transition-colors">
          {SITE_CONFIG.brandName}
        </span>
        <span class="text-[11px] font-medium tracking-wider text-[#588DFF] uppercase -mt-0.5">
          {SITE_CONFIG.brandNameEn}
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Menu -->
    <nav class="hidden md:flex items-center gap-1 lg:gap-2" aria-label="全站主导航">
      {SITE_CONFIG.navLinks.map((item) => (
        <a
          href={item.href}
          class="px-3.5 py-2 text-sm font-medium text-[#D4C8ED] hover:text-white hover:bg-[#8B40FF]/15 rounded-lg transition-colors"
        >
          {item.name}
        </a>
      ))}
    </nav>

    <!-- Header Actions (Search & Register) -->
    <div class="hidden sm:flex items-center gap-3">
      <!-- Search Trigger Button -->
      <button
        id="search-trigger-btn"
        type="button"
        class="flex items-center gap-2 px-3 py-1.5 text-xs font-medium text-[#D4C8ED] bg-[#160C32]/80 hover:bg-[#8B40FF]/25 border border-[#8B40FF]/30 hover:border-[#8B40FF]/60 rounded-lg transition-all"
        title="搜索全站文章与教程"
        aria-label="打开搜索框"
      >
        <svg class="w-3.5 h-3.5 text-[#B87AFF]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span>搜索教程...</span>
        <kbd class="hidden lg:inline-block px-1.5 py-0.5 text-[10px] text-[#D4C8ED]/60 bg-[#09071C] rounded border border-[#8B40FF]/20">⌘K</kbd>
      </button>

      <!-- Primary CTA: 立即注册 (Unified config) -->
      <a
        href={SITE_CONFIG.registerUrl}
        target="_blank"
        rel="sponsored noopener noreferrer"
        class="relative inline-flex items-center justify-center px-5 py-2 text-sm font-semibold text-white rounded-lg overflow-hidden group shadow-[0_0_20px_rgba(139,64,255,0.4)] transition-all duration-300 hover:shadow-[0_0_28px_rgba(193,91,255,0.65)] hover:scale-[1.02]"
      >
        <span class="absolute inset-0 bg-gradient-to-r from-[#8B40FF] via-[#C15BFF] to-[#588DFF] transition-all duration-300 group-hover:opacity-90"></span>
        <span class="relative flex items-center gap-1.5">
          <span>立即注册</span>
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </span>
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <div class="flex items-center gap-2 md:hidden">
      <button
        id="mobile-search-btn"
        type="button"
        class="p-2 text-[#D4C8ED] hover:text-white bg-[#160C32]/60 rounded-lg border border-[#8B40FF]/20"
        aria-label="打开搜索"
      >
        <svg class="w-5 h-5 text-[#B87AFF]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </button>

      <button
        id="mobile-menu-btn"
        type="button"
        class="p-2 text-[#D4C8ED] hover:text-white bg-[#160C32]/80 hover:bg-[#8B40FF]/20 rounded-lg border border-[#8B40FF]/30 transition-colors"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
        aria-label="切换移动端导航菜单"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path id="menu-icon-bars" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          <path id="menu-icon-close" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div
    id="mobile-nav-drawer"
    class="hidden md:hidden border-b border-[#8B40FF]/30 bg-[#09071C]/98 px-4 pt-3 pb-6 transition-all duration-300"
  >
    <div class="flex flex-col space-y-2">
      {SITE_CONFIG.navLinks.map((item) => (
        <a
          href={item.href}
          class="mobile-nav-link px-4 py-2.5 text-base font-medium text-[#D4C8ED] hover:text-white hover:bg-[#8B40FF]/20 rounded-lg transition-colors"
        >
          {item.name}
        </a>
      ))}

      <div class="pt-3 border-t border-[#8B40FF]/20">
        <a
          href={SITE_CONFIG.registerUrl}
          target="_blank"
          rel="sponsored noopener noreferrer"
          class="w-full flex items-center justify-center gap-2 py-3 px-4 text-center font-semibold text-white bg-gradient-to-r from-[#8B40FF] to-[#588DFF] rounded-lg shadow-[0_0_20px_rgba(139,64,255,0.4)]"
        >
          <span>立即注册灵动云</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  function setupHeader() {
    const menuBtn = document.getElementById('mobile-menu-btn');
    const drawer = document.getElementById('mobile-nav-drawer');
    const iconBars = document.getElementById('menu-icon-bars');
    const iconClose = document.getElementById('menu-icon-close');

    if (menuBtn && drawer && iconBars && iconClose) {
      menuBtn.addEventListener('click', () => {
        const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
        menuBtn.setAttribute('aria-expanded', String(!isExpanded));
        drawer.classList.toggle('hidden');
        iconBars.classList.toggle('hidden');
        iconClose.classList.toggle('hidden');
      });

      // Close drawer on link click
      const links = drawer.querySelectorAll('.mobile-nav-link');
      links.forEach((link) => {
        link.addEventListener('click', () => {
          drawer.classList.add('hidden');
          menuBtn.setAttribute('aria-expanded', 'false');
          iconBars.classList.remove('hidden');
          iconClose.classList.add('hidden');
        });
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupHeader);
  } else {
    setupHeader();
  }
</script>
