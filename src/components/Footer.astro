---
// Footer.astro: 灵动云帮助中心页脚
// 本站独立运营，不链接任何其他灵动云域名。
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { SITE_CONFIG } from '../config/site';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer relative w-full pt-14 pb-28 text-ink-2">
  <div class="wrap">
    <div class="grid grid-cols-1 gap-10 border-b border-line pb-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      <!-- Brand -->
      <div class="space-y-4 lg:col-span-2">
        <Logo />
        <p class="max-w-md text-sm leading-[1.85] text-ink-3">
          帮助中心整理灵动云的连接问题排查步骤、线路与代理模式等网络知识，以及账户和订阅链接的安全说明；照着步骤解决不了时，可以直接联系在线客服或在用户中心提交工单。
        </p>
      </div>

      <!-- Help center links -->
      <div>
        <h2 class="mb-2 text-sm font-semibold text-ink">帮助中心</h2>
        <ul role="list">
          <li><a href="/#problems" class="footer-link">按问题找答案</a></li>
          <li><a href="/guides/troubleshooting/" class="footer-link">连接问题排查步骤</a></li>
          <li><a href="/#knowledge" class="footer-link">网络知识</a></li>
          <li><a href="/#faq" class="footer-link">常见问题</a></li>
        </ul>
      </div>

      <!-- Support & legal -->
      <div>
        <h2 class="mb-2 text-sm font-semibold text-ink">联系与支持</h2>
        <ul role="list">
          <li>
            <button id="footer-crisp-btn" type="button" data-open-crisp class="footer-link text-left !text-lilac hover:!text-ink">
              <Icon name="chat" class="!h-4 !w-4 !text-lilac" />
              <span>在线客服（Crisp 对话）</span>
            </button>
          </li>
          <li>
            <a href={SITE_CONFIG.registerUrl} target="_blank" rel="noopener" class="footer-link">
              <span>用户中心（注册 / 登录 / 工单）</span>
              <Icon name="external" />
            </a>
          </li>
          <li><a href="/privacy/" class="footer-link">隐私政策</a></li>
          <li><a href="/terms/" class="footer-link">服务条款</a></li>
        </ul>
      </div>
    </div>

    <!-- Official statement (exact wording, shared by all sub-sites) -->
    <div class="flex flex-col gap-1 pt-6 text-sm sm:flex-row sm:items-start sm:justify-between sm:gap-8">
      <div>
        <p class="leading-7 text-ink-2">
          本站是灵动云官方「帮助中心」站点。
        </p>
        <p class="text-xs text-ink-3">价格与套餐规则以用户中心实时显示为准。</p>
      </div>
      <p class="pt-4 text-xs text-ink-3 sm:pt-3 tabular-nums">© {currentYear} {SITE_CONFIG.brandName} ({SITE_CONFIG.brandNameEn})</p>
    </div>
  </div>
</footer>
