---
// GuidesSection.astro: 首页「网络知识」——解释原因的知识文章（排查步骤单独在「按问题找答案」中）
// 布局：第一篇做通栏主卡（右侧是线路示意图，纯装饰），其余四篇做成两列索引。
import Icon from './Icon.astro';
import { ARTICLES_DATA } from '../data/articles';
import { categoryIcon } from '../utils/topic';

const knowledge = ARTICLES_DATA.filter((a) => a.kind === 'knowledge');
const [featured, ...rest] = knowledge;
---

<section id="knowledge" class="section">
  <div class="wrap">
    <div class="section-head">
      <div class="kicker">
        <span>弄清原因</span>
      </div>
      <h2 class="section-title">网络知识</h2>
      <p class="section-lead">
        想知道问题为什么会出现，而不只是解决眼前这一次？下面几篇解释线路与稳定性、代理模式、账户安全和跨境访问的基本原理。
      </p>
    </div>

    <div class="kb-grid">
      {featured && (
        <a href={featured.path} class="kb-feature glass group">
          <div>
            <div class="flex flex-wrap items-center gap-4">
              <span class="icon-tile"><Icon name={categoryIcon(featured.category)} /></span>
              <div class="kb-meta">
                <span class="chip">{featured.category}</span>
                <span class="tabular-nums">{featured.readTime}</span>
              </div>
            </div>
            <h3 class="mt-5 text-xl font-semibold leading-[1.45] text-ink sm:text-2xl">{featured.title}</h3>
            <p class="mt-3 max-w-[40rem] text-[0.9375rem] leading-[1.85] text-ink-2">{featured.description}</p>
            <span class="more mt-5">
              <span>阅读全文</span>
              <Icon name="arrow-right" />
            </span>
          </div>

          <!-- 线路示意：两端之间的多条线路，中间一条直连线带安全盾（装饰） -->
          <svg class="kb-routes" viewBox="0 0 320 180" fill="none" aria-hidden="true">
            <path d="M40 90C100 90 112 20 160 20S220 90 280 90" stroke="#8B5CF6" stroke-opacity=".45" stroke-width="1.5" stroke-dasharray="5 7" />
            <path d="M40 90C100 90 115 52 160 52S220 90 280 90" stroke="#C4B5FD" stroke-opacity=".32" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="0.01 6" />
            <path d="M40 90C100 90 115 128 160 128S220 90 280 90" stroke="#C4B5FD" stroke-opacity=".32" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="0.01 6" />
            <path d="M40 90C100 90 112 160 160 160S220 90 280 90" stroke="#8B5CF6" stroke-opacity=".45" stroke-width="1.5" stroke-dasharray="5 7" />
            <path d="M40 90H280" stroke="#C4B5FD" stroke-opacity=".85" stroke-width="2" />
            <g fill="#8B5CF6">
              <rect x="70" y="87" width="6" height="6" rx="1" />
              <rect x="100" y="87" width="6" height="6" rx="1" />
              <rect x="208" y="87" width="6" height="6" rx="1" />
              <rect x="238" y="87" width="6" height="6" rx="1" />
              <circle cx="160" cy="20" r="2.5" />
              <circle cx="160" cy="160" r="2.5" />
            </g>
            <path d="M160 74c5 3 10 4.4 15 5v9c0 8.6-6.2 15.4-15 18.4-8.8-3-15-9.8-15-18.4v-9c5-.6 10-2 15-5Z" fill="#1A1340" stroke="#C4B5FD" stroke-width="1.5" stroke-linejoin="round" />
            <path d="m154.5 89.5 3.8 3.8 7.2-7.4" stroke="#CEB5F9" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
            <circle cx="30" cy="90" r="10" fill="#130D2E" stroke="#C4B5FD" stroke-width="1.5" />
            <circle cx="30" cy="90" r="3.5" fill="#C4B5FD" />
            <circle cx="290" cy="90" r="10" fill="#130D2E" stroke="#C4B5FD" stroke-width="1.5" />
            <circle cx="290" cy="90" r="3.5" fill="#C4B5FD" />
          </svg>
        </a>
      )}

      <ul class="kb-list kb-list-2col glass" role="list">
        {rest.map((article) => (
          <li>
            <a href={article.path} class="kb-row group">
              <span class="icon-tile icon-tile-sm mt-0.5"><Icon name={categoryIcon(article.category)} /></span>
              <div class="min-w-0 flex-1">
                <div class="kb-meta">
                  <span class="font-medium text-lilac">{article.category}</span>
                  <span class="tabular-nums">{article.readTime}</span>
                </div>
                <h3 class="mt-1.5 text-base font-semibold leading-[1.55] text-ink sm:text-[1.0625rem]">{article.title}</h3>
                <p class="mt-1.5 text-sm leading-[1.8] text-ink-2">{article.description}</p>
                <span class="more mt-3">
                  <span>阅读全文</span>
                  <Icon name="arrow-right" />
                </span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
