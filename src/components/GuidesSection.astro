---
// GuidesSection.astro: 首页使用教程与节点知识展示区（8篇SEO原创文章直达入口）
import { ARTICLES_DATA } from '../data/articles';
---

<section id="guides" class="py-24 relative z-10 scroll-mt-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#C15BFF]/15 border border-[#C15BFF]/30 text-xs font-semibold text-[#C15BFF] mb-4">
        <span>官方知识库 · 新手教程与节点科普</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white mb-4">
        灵动云 <span class="bg-gradient-to-r from-[#C15BFF] via-[#8B40FF] to-[#588DFF] bg-clip-text text-transparent">使用教程与网络指南</span>
      </h2>
      <p class="text-base sm:text-lg text-[#D4C8ED]/85 leading-relaxed">
        提供从新手入门到高阶优化的全面技术指引，涵盖 Clash 配置、BGP 专线解析、安全防护常识与 ChatGPT/Claude 顺畅连接技巧。
      </p>
    </div>

    <!-- 8 Articles Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {ARTICLES_DATA.map((article) => (
        <a
          href={article.path}
          class="group relative flex flex-col justify-between p-6 rounded-2xl bg-[#160C32]/70 border border-[#8B40FF]/25 hover:border-[#C15BFF]/60 hover:bg-[#160C32]/95 backdrop-blur-md transition-all duration-300 hover:-translate-y-1.5 hover:shadow-[0_12px_35px_-8px_rgba(139,64,255,0.35)]"
        >
          <div>
            <!-- Meta top bar -->
            <div class="flex items-center justify-between text-xs text-[#D4C8ED]/70 mb-3.5">
              <span class="px-2.5 py-0.5 rounded-full bg-[#8B40FF]/20 text-[#B87AFF] font-medium border border-[#8B40FF]/30">
                {article.category}
              </span>
              <span>{article.readTime}</span>
            </div>

            <!-- Title -->
            <h3 class="text-base font-bold text-white group-hover:text-[#C15BFF] transition-colors line-clamp-2 mb-3 leading-snug">
              {article.title}
            </h3>

            <!-- Summary -->
            <p class="text-xs text-[#D4C8ED]/75 line-clamp-3 leading-relaxed mb-4">
              {article.summary}
            </p>
          </div>

          <!-- Bottom Read More Link -->
          <div class="pt-4 border-t border-[#8B40FF]/15 flex items-center justify-between text-xs font-semibold text-[#588DFF] group-hover:text-white transition-colors">
            <span>阅读完整指南</span>
            <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
