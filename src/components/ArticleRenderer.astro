---
// ArticleRenderer.astro: 帮助中心文章正文渲染（Markdown → 语义化 HTML）
// 本文目录由 ArticleLayout 生成（桌面端在右侧固定，手机端在正文上方）。
import { renderMarkdown, normalizeArticleContent } from '../utils/markdown';

interface Props {
  content: unknown;
}

const { content } = Astro.props;

const renderedHtml = renderMarkdown(normalizeArticleContent(content));
---

<div class="article-content-body prose-help" set:html={renderedHtml} />
