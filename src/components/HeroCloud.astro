---
// HeroCloud.astro: 灵动云大型原创动态科技云端主视觉
---

<div id="hero-cloud-wrapper" class="relative w-full max-w-[540px] lg:max-w-[620px] mx-auto aspect-square flex items-center justify-center transition-transform duration-500 ease-out">
  <!-- Outer Radial Energy Ring Glow -->
  <div class="absolute inset-8 rounded-full bg-gradient-to-tr from-[#8B40FF]/30 via-[#C15BFF]/20 to-[#588DFF]/25 blur-[60px] animate-pulse-glow pointer-events-none"></div>

  <!-- SVG Tech Cloud & Cyber City Artwork -->
  <svg viewBox="0 0 600 600" class="w-full h-full relative z-10 drop-shadow-[0_20px_50px_rgba(139,64,255,0.4)]" fill="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <!-- Gradients -->
      <linearGradient id="cloudGradMain" x1="120" y1="180" x2="480" y2="440" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#C15BFF" stop-opacity="0.85" />
        <stop offset="45%" stop-color="#8B40FF" stop-opacity="0.8" />
        <stop offset="85%" stop-color="#160C32" stop-opacity="0.95" />
        <stop offset="100%" stop-color="#588DFF" stop-opacity="0.75" />
      </linearGradient>

      <linearGradient id="cloudGradBack" x1="150" y1="120" x2="450" y2="380" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#588DFF" stop-opacity="0.4" />
        <stop offset="50%" stop-color="#8B40FF" stop-opacity="0.3" />
        <stop offset="100%" stop-color="#160C32" stop-opacity="0.2" />
      </linearGradient>

      <linearGradient id="railGrad1" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#C15BFF" />
        <stop offset="50%" stop-color="#B87AFF" />
        <stop offset="100%" stop-color="#588DFF" />
      </linearGradient>

      <linearGradient id="railGrad2" x1="100%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#588DFF" />
        <stop offset="60%" stop-color="#8B40FF" />
        <stop offset="100%" stop-color="#C15BFF" />
      </linearGradient>

      <linearGradient id="cityGrad" x1="300" y1="280" x2="300" y2="420" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#D4C8ED" stop-opacity="0.8" />
        <stop offset="60%" stop-color="#8B40FF" stop-opacity="0.5" />
        <stop offset="100%" stop-color="#160C32" stop-opacity="0.9" />
      </linearGradient>

      <linearGradient id="glowLine" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="transparent" />
        <stop offset="50%" stop-color="#B87AFF" />
        <stop offset="100%" stop-color="transparent" />
      </linearGradient>

      <!-- Glow Filters -->
      <filter id="cloudSoftGlow" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="8" result="blur" />
        <feComposite in="SourceGraphic" in2="blur" operator="over" />
      </filter>

      <filter id="nodeGlow" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="3.5" result="blur" />
        <feComposite in="SourceGraphic" in2="blur" operator="over" />
      </filter>
    </defs>

    <!-- Background Secondary Cloud Depth Layer -->
    <g class="animate-float-slow" style="animation-duration: 9s; transform-origin: center;">
      <path d="M210 240 C170 240 140 270 140 310 C140 315 141 320 143 325 C120 335 105 358 105 385 C105 425 138 455 178 455 L430 455 C470 455 500 425 500 385 C500 355 480 330 450 322 C450 318 450 314 450 310 C450 260 410 220 360 220 C335 220 312 230 295 248 C280 230 258 220 232 220 C224 220 217 221 210 224 Z" fill="url(#cloudGradBack)" filter="url(#cloudSoftGlow)" opacity="0.6" />
    </g>

    <!-- Main Floating Tech Cloud Body -->
    <g id="main-cloud-group" class="animate-float-slow" style="transform-origin: center;">
      <!-- Base Cloud Solid-Translucent Hull -->
      <path d="M225 210 C185 210 152 242 152 282 C152 288 153 294 156 300 C130 312 112 338 112 368 C112 412 148 448 192 448 L418 448 C462 448 498 412 498 368 C498 335 476 307 444 298 C447 291 448 284 448 276 C448 228 409 188 360 188 C332 188 307 200 290 220 C274 200 250 188 225 188 C215 188 205 190 196 194 C190 204 186 215 186 226 Z" fill="url(#cloudGradMain)" stroke="#B87AFF" stroke-width="1.8" stroke-opacity="0.65" filter="url(#cloudSoftGlow)" />

      <!-- Internal Tech Circuits & Optical Fiber Lines -->
      <g opacity="0.65">
        <path d="M190 380 L240 380 L270 340 L340 340 L370 380 L420 380" stroke="#588DFF" stroke-width="1.5" stroke-dasharray="4 3" />
        <path d="M230 420 L260 380 L310 380 L340 420 L400 420" stroke="#B87AFF" stroke-width="1.2" stroke-dasharray="6 3" />
        <path d="M280 290 L300 250 L340 250 L360 290" stroke="#C15BFF" stroke-width="1.5" />
        <line x1="300" y1="250" x2="300" y2="340" stroke="#588DFF" stroke-width="1" stroke-dasharray="3 3" />
        <line x1="340" y1="250" x2="340" y2="340" stroke="#C15BFF" stroke-width="1" stroke-dasharray="3 3" />
      </g>

      <!-- Future Cyber City Skyline Silhouettes within Cloud -->
      <g opacity="0.85">
        <!-- Building 1: Tower Left -->
        <rect x="235" y="270" width="18" height="110" fill="url(#cityGrad)" rx="2" />
        <line x1="244" y1="252" x2="244" y2="270" stroke="#588DFF" stroke-width="1.5" />
        <circle cx="244" cy="250" r="2" fill="#588DFF" />
        <!-- Window Lights -->
        <rect x="238" y="280" width="3" height="3" fill="#FFFFFF" opacity="0.9" />
        <rect x="246" y="280" width="3" height="3" fill="#588DFF" opacity="0.9" />
        <rect x="238" y="292" width="3" height="3" fill="#B87AFF" opacity="0.8" />
        <rect x="246" y="292" width="3" height="3" fill="#FFFFFF" opacity="0.9" />
        <rect x="238" y="304" width="3" height="3" fill="#FFFFFF" opacity="0.9" />
        <rect x="246" y="304" width="3" height="3" fill="#C15BFF" opacity="0.8" />

        <!-- Building 2: Central Cyber Spire -->
        <polygon points="295,200 315,200 320,380 290,380" fill="url(#cityGrad)" />
        <line x1="305" y1="165" x2="305" y2="200" stroke="#C15BFF" stroke-width="2" />
        <circle cx="305" cy="163" r="3" fill="#FFFFFF" filter="url(#nodeGlow)" />
        <!-- Antenna pulse rings -->
        <circle cx="305" cy="163" r="8" stroke="#C15BFF" stroke-width="1" stroke-dasharray="2 2" opacity="0.6" class="animate-pulse" />
        <!-- Spire core line -->
        <line x1="305" y1="205" x2="305" y2="370" stroke="#588DFF" stroke-width="1.5" opacity="0.75" />

        <!-- Building 3: Stepped Tech Tower Right -->
        <rect x="345" y="255" width="24" height="125" fill="url(#cityGrad)" rx="2" />
        <polygon points="345,255 357,235 369,255" fill="#8B40FF" opacity="0.8" />
        <line x1="357" y1="220" x2="357" y2="235" stroke="#588DFF" stroke-width="1.5" />
        <circle cx="357" cy="218" r="2.5" fill="#588DFF" />
        <!-- Windows -->
        <rect x="350" y="265" width="4" height="3" fill="#FFFFFF" opacity="0.9" />
        <rect x="358" y="265" width="4" height="3" fill="#588DFF" opacity="0.9" />
        <rect x="350" y="278" width="4" height="3" fill="#B87AFF" opacity="0.8" />
        <rect x="358" y="278" width="4" height="3" fill="#FFFFFF" opacity="0.9" />

        <!-- Secondary Mid-height buildings -->
        <rect x="260" y="300" width="26" height="80" fill="url(#cityGrad)" opacity="0.9" rx="1" />
        <rect x="265" y="310" width="3" height="3" fill="#588DFF" opacity="0.8" />
        <rect x="275" y="310" width="3" height="3" fill="#FFFFFF" opacity="0.9" />
        <rect x="265" y="322" width="3" height="3" fill="#FFFFFF" opacity="0.9" />
        <rect x="275" y="322" width="3" height="3" fill="#C15BFF" opacity="0.8" />

        <rect x="325" y="295" width="16" height="85" fill="url(#cityGrad)" opacity="0.85" rx="1" />
        <rect x="330" y="305" width="3" height="3" fill="#FFFFFF" opacity="0.9" />
        <rect x="330" y="318" width="3" height="3" fill="#588DFF" opacity="0.9" />

        <rect x="375" y="315" width="22" height="65" fill="url(#cityGrad)" opacity="0.8" rx="1" />
        <rect x="382" y="325" width="3" height="3" fill="#B87AFF" opacity="0.85" />
      </g>

      <!-- Network Nodes (Global Interconnected Points) -->
      <g>
        <circle cx="210" cy="350" r="4.5" fill="#FFFFFF" filter="url(#nodeGlow)" />
        <circle cx="270" cy="340" r="5" fill="#588DFF" filter="url(#nodeGlow)" />
        <circle cx="340" cy="340" r="5" fill="#C15BFF" filter="url(#nodeGlow)" />
        <circle cx="410" cy="360" r="4.5" fill="#FFFFFF" filter="url(#nodeGlow)" />
        <circle cx="305" cy="275" r="5.5" fill="#B87AFF" filter="url(#nodeGlow)" />
        <circle cx="230" cy="250" r="4" fill="#588DFF" filter="url(#nodeGlow)" />
        <circle cx="380" cy="260" r="4" fill="#FFFFFF" filter="url(#nodeGlow)" />
      </g>
    </g>

    <!-- Flowing Orbital Light Rail 1 (Clockwise Ring) -->
    <g class="animate-orbit" style="transform-origin: 300px 320px;">
      <ellipse cx="300" cy="320" rx="230" ry="85" stroke="url(#railGrad1)" stroke-width="2.5" stroke-dasharray="40 180" transform="rotate(-25 300 320)" opacity="0.85" filter="url(#cloudSoftGlow)" />
      <!-- Orbital satellite dot on Rail 1 -->
      <g transform="rotate(-25 300 320)">
        <circle cx="530" cy="320" r="5.5" fill="#FFFFFF" filter="url(#nodeGlow)" />
        <circle cx="530" cy="320" r="11" stroke="#C15BFF" stroke-width="1.5" opacity="0.7" />
      </g>
    </g>

    <!-- Flowing Orbital Light Rail 2 (Counter-Clockwise Ring) -->
    <g class="animate-orbit-reverse" style="transform-origin: 300px 320px;">
      <ellipse cx="300" cy="320" rx="245" ry="95" stroke="url(#railGrad2)" stroke-width="2" stroke-dasharray="60 160" transform="rotate(35 300 320)" opacity="0.8" filter="url(#cloudSoftGlow)" />
      <!-- Orbital satellite dot on Rail 2 -->
      <g transform="rotate(35 300 320)">
        <circle cx="70" cy="320" r="4.5" fill="#588DFF" filter="url(#nodeGlow)" />
        <circle cx="70" cy="320" r="9" stroke="#588DFF" stroke-width="1.2" opacity="0.6" />
      </g>
    </g>

    <!-- Floating Micro Sparkles / Data Packets -->
    <circle cx="160" cy="180" r="2" fill="#FFFFFF" class="animate-ping" style="animation-duration: 3s; animation-delay: 0.5s;" />
    <circle cx="460" cy="190" r="2.5" fill="#588DFF" class="animate-ping" style="animation-duration: 4s; animation-delay: 1.2s;" />
    <circle cx="140" cy="420" r="2" fill="#C15BFF" class="animate-ping" style="animation-duration: 3.5s; animation-delay: 2s;" />
    <circle cx="470" cy="420" r="2" fill="#FFFFFF" class="animate-ping" style="animation-duration: 4.5s; animation-delay: 0.8s;" />
    <circle cx="300" cy="110" r="3" fill="#B87AFF" class="animate-ping" style="animation-duration: 3.2s; animation-delay: 1.8s;" />
  </svg>

  <!-- Ambient Light Reflection Below Cloud -->
  <div class="absolute -bottom-6 w-3/4 h-12 bg-gradient-to-r from-transparent via-[#8B40FF]/30 to-transparent blur-xl pointer-events-none"></div>
</div>

<script>
  function setupMouseParallax() {
    const wrapper = document.getElementById('hero-cloud-wrapper');
    if (!wrapper) return;

    // Check prefers-reduced-motion or mobile
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || window.innerWidth < 1024) {
      return;
    }

    let targetX = 0;
    let targetY = 0;
    let currentX = 0;
    let currentY = 0;
    let rafId: number | null = null;

    const handleMouseMove = (e: MouseEvent) => {
      const centerX = window.innerWidth / 2;
      const centerY = window.innerHeight / 2;
      // Gentle subtle factor (max ±12px)
      targetX = ((e.clientX - centerX) / centerX) * 12;
      targetY = ((e.clientY - centerY) / centerY) * 12;
    };

    function updatePosition() {
      // Smooth lerp
      currentX += (targetX - currentX) * 0.08;
      currentY += (targetY - currentY) * 0.08;

      if (wrapper) {
        wrapper.style.transform = `translate3d(${currentX.toFixed(2)}px, ${currentY.toFixed(2)}px, 0)`;
      }

      rafId = requestAnimationFrame(updatePosition);
    }

    window.addEventListener('mousemove', handleMouseMove, { passive: true });
    rafId = requestAnimationFrame(updatePosition);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupMouseParallax);
  } else {
    setupMouseParallax();
  }
</script>
