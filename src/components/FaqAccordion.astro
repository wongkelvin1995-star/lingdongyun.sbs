---
// FaqAccordion.astro: 帮助中心常见问题（FAQPage 结构化数据由首页通过 BaseLayout 输出）
import Icon from './Icon.astro';
import CtaLanes from './CtaLanes.astro';
import { FAQS_DATA } from '../data/faqs';
---

<section id="faq" class="section">
  <div class="wrap">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-14">
      <div class="section-head lg:sticky lg:top-24 lg:mb-0 lg:self-start">
        <div class="kicker">
          <span>求助前先看</span>
        </div>
        <h2 class="section-title">常见问题</h2>
        <p class="section-lead">这里是联系客服前最常被问到的几个问题，每条都附有详细说明的链接。</p>
      </div>

      <div class="faq-list glass">
        {FAQS_DATA.map((faq, index) => (
          <details class="faq-item group" open={index === 0}>
            <summary>
              <h3 class="text-[0.9375rem] font-semibold leading-[1.6] text-ink sm:text-[1.0625rem]">{faq.question}</h3>
              <span class="faq-toggle"><Icon name="plus" /></span>
            </summary>
            <div class="faq-answer">
              <p>{faq.answer}</p>
              {faq.link && (
                <a href={faq.link.href} class="more mt-2 min-h-11">
                  <span>{faq.link.label}</span>
                  <Icon name="arrow-right" />
                </a>
              )}
            </div>
          </details>
        ))}
      </div>
    </div>

    <div class="cta-panel glass mt-12 sm:mt-16">
      <CtaLanes />
      <p class="text-xl font-semibold text-ink">没有找到你的问题？</p>
      <p class="mx-auto mt-2 max-w-xl text-[0.9375rem] leading-[1.85] text-ink-2">
        换个关键词搜索一下，或者直接把情况告诉在线客服。
      </p>
      <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <button type="button" data-open-search class="btn btn-secondary btn-lg w-full sm:w-auto">
          <Icon name="search" />
          搜索帮助中心
        </button>
        <button type="button" data-open-crisp class="btn btn-primary btn-lg w-full sm:w-auto">
          <Icon name="chat" />
          联系在线客服
        </button>
      </div>
    </div>
  </div>
</section>
