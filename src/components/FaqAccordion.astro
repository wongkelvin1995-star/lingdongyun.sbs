---
// FaqAccordion.astro: 15个常见问题手风琴组件与 FAQPage 结构化数据
import { FAQS_DATA } from '../data/faqs';
import { SITE_CONFIG } from '../config/site';

// Generate FAQPage JSON-LD Schema
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS_DATA.map((item) => ({
    '@type': 'Question',
    name: item.question.replace(/^\d+\.\s*/, ''),
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<section id="faq" class="py-24 relative z-10 scroll-mt-16">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#8B40FF]/15 border border-[#8B40FF]/30 text-xs font-semibold text-[#B87AFF] mb-4">
        <span>答疑解惑 · 真实透明</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white mb-4">
        灵动云 <span class="bg-gradient-to-r from-[#C15BFF] via-[#8B40FF] to-[#588DFF] bg-clip-text text-transparent">常见问题解答 (FAQ)</span>
      </h2>
      <p class="text-base sm:text-lg text-[#D4C8ED]/85 leading-relaxed">
        针对套餐选购、Clash 节点导入、BGP 专线原理以及账户安全等最关心的疑问，提供详尽专业的官方解答。
      </p>
    </div>

    <!-- Accordion List -->
    <div class="space-y-4">
      {FAQS_DATA.map((faq, index) => (
        <details
          class="group rounded-2xl bg-[#160C32]/75 border border-[#8B40FF]/25 hover:border-[#B87AFF]/50 transition-all duration-300 overflow-hidden"
          open={index === 0}
        >
          <summary class="flex items-center justify-between p-5 sm:p-6 text-base sm:text-lg font-bold text-white cursor-pointer select-none list-none focus:outline-none focus:bg-[#8B40FF]/15">
            <span class="pr-4">{faq.question}</span>
            <div class="w-8 h-8 rounded-full bg-[#8B40FF]/20 border border-[#8B40FF]/30 flex items-center justify-center shrink-0 text-[#B87AFF] group-open:rotate-180 group-open:bg-[#8B40FF] group-open:text-white transition-all duration-300">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </summary>
          <div class="px-5 pb-6 sm:px-6 sm:pb-7 text-sm sm:text-base leading-relaxed text-[#D4C8ED]/90 border-t border-[#8B40FF]/15 pt-4">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>

    <!-- Post-FAQ CTA Banner -->
    <div class="mt-14 p-8 rounded-3xl bg-gradient-to-br from-[#160C32]/95 via-[#25124f]/90 to-[#09071C] border border-[#8B40FF]/40 text-center shadow-[0_10px_40px_rgba(139,64,255,0.25)] relative overflow-hidden">
      <div class="absolute -top-24 -right-24 w-60 h-60 bg-[#C15BFF]/20 rounded-full blur-3xl pointer-events-none"></div>
      <div class="relative z-10">
        <h3 class="text-2xl font-bold text-white mb-3">准备好开启高速稳定的网络连接了吗？</h3>
        <p class="text-sm text-[#D4C8ED]/85 max-w-xl mx-auto mb-6">
          即刻注册灵动云，最低仅需 ¥20/月或 ¥99/年，尊享 BGP 专线直连与全平台极速配置支持。
        </p>
        <a
          href={SITE_CONFIG.registerUrl}
          target="_blank"
          rel="sponsored noopener noreferrer"
          class="inline-flex items-center gap-2 px-8 py-3.5 rounded-xl font-bold text-white bg-gradient-to-r from-[#8B40FF] via-[#C15BFF] to-[#588DFF] hover:shadow-[0_0_30px_rgba(193,91,255,0.6)] hover:scale-105 transition-all duration-300"
        >
          <span>立即前往灵动云官方注册</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Inject FAQPage Schema -->
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
