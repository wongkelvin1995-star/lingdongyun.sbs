---
// Breadcrumbs.astro: 面包屑导航（BreadcrumbList 结构化数据由页面通过 breadcrumbJsonLd() 传给 BaseLayout）
import type { Crumb } from '../utils/schema';

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="面包屑导航">
  <ol class="flex min-w-0 flex-wrap items-center gap-x-1.5 text-[0.8125rem] text-ink-3 sm:text-sm">
    {items.map((item, index) => {
      const isLast = index === items.length - 1;
      return (
        <li class="flex min-w-0 items-center gap-1.5">
          {index > 0 && (
            <svg class="h-3.5 w-3.5 shrink-0 text-lilac/50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m9.5 6 6 6-6 6" />
            </svg>
          )}
          {isLast ? (
            <span class="max-w-[220px] truncate text-ink-2 sm:max-w-md" aria-current="page">
              {item.name}
            </span>
          ) : (
            <a href={item.path} class="inline-flex min-h-11 items-center rounded-chip transition-colors hover:text-ink">
              {item.name}
            </a>
          )}
        </li>
      );
    })}
  </ol>
</nav>
