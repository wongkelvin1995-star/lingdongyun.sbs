---
// CrispFloatingWidget.astro: 帮助中心的 Crisp 在线客服悬浮按钮
// 品牌紫胶囊按钮（手机上为圆形图标）；页面加载时不弹出对话，只有点击后才打开。
import Icon from './Icon.astro';
import { SITE_CONFIG } from '../config/site';
---

<!-- Custom Floating Crisp Launcher -->
<div id="crisp-custom-launcher" class="crisp-launcher" role="button" tabindex="0" aria-label="打开在线客服（Crisp 对话）">
  <Icon name="chat" />
  <span class="crisp-launcher-label">在线客服</span>
</div>

<!-- 客服脚本没加载出来时的提示（网络慢或被拦截），避免「点了没反应」 -->
<div id="crisp-fallback" class="crisp-fallback" role="status" aria-live="polite" hidden>
  <p class="crisp-fallback-title" data-crisp-fallback-title>正在连接在线客服…</p>
  <p class="crisp-fallback-text" data-crisp-fallback-text hidden>在线客服加载较慢。可以先在新窗口打开客服对话页，或登录用户中心提交工单。</p>
  <div class="crisp-fallback-actions" data-crisp-fallback-actions hidden>
    <a class="btn btn-primary" href={SITE_CONFIG.crispChatUrl} target="_blank" rel="noopener">打开客服对话页</a>
    <a class="btn btn-secondary" href={SITE_CONFIG.registerUrl} target="_blank" rel="noopener">登录后提交工单</a>
  </div>
  <button type="button" class="crisp-fallback-close" data-crisp-fallback-close aria-label="关闭提示">×</button>
</div>

<!-- CSS to Hide Default Crisp Circular Launcher -->
<style is:global>
  .crisp-launcher { transition: opacity .2s ease, transform .2s ease, visibility 0s linear 0s; }
  .crisp-launcher.is-quiet { opacity: 0; visibility: hidden; transform: translateY(8px); pointer-events: none; transition: opacity .2s ease, transform .2s ease, visibility 0s linear .2s; }
  @media (prefers-reduced-motion: reduce) { .crisp-launcher, .crisp-launcher.is-quiet { transition: none; } }

  .crisp-fallback {
    position: fixed; right: max(1rem, env(safe-area-inset-right, 0px)); bottom: calc(5rem + env(safe-area-inset-bottom, 0px)); z-index: 45;
    width: min(22rem, calc(100vw - 2rem)); padding: 1rem 2.75rem 1rem 1rem; border-radius: 1rem;
    border: 1px solid rgb(196 181 253 / 0.28); background: rgb(19 13 46 / 0.97); color: #ece9ff;
    box-shadow: 0 18px 48px -12px rgb(0 0 0 / 0.6);
  }
  .crisp-fallback[hidden] { display: none !important; }
  .crisp-fallback-title { font-size: 0.95rem; font-weight: 600; line-height: 1.5; }
  .crisp-fallback-text { margin-top: 0.35rem; font-size: 0.875rem; line-height: 1.7; color: #c9c2ef; }
  .crisp-fallback-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem; }
  .crisp-fallback-close {
    position: absolute; top: 0.375rem; right: 0.375rem; width: 2.5rem; height: 2.5rem; border: 0; border-radius: 999px;
    background: transparent; color: #c9c2ef; font-size: 1.35rem; line-height: 1; cursor: pointer;
  }
  .crisp-fallback-close:hover { color: #fff; background: rgb(255 255 255 / 0.08); }
  .crisp-fallback-close:focus-visible { outline: 2px solid #c4b5fd; outline-offset: 2px; }
  @media (min-width: 640px) { .crisp-fallback { right: 1.5rem; bottom: calc(5.5rem + env(safe-area-inset-bottom, 0px)); } }

  /* 隐藏 Crisp 原生默认的圆形按钮，只保留本站的在线客服按钮 */
  .crisp-client .cc-tlyq,
  .crisp-client [data-chat-status="closed"] .cc-1x8g,
  .crisp-client .cc-1x8g,
  .crisp-client .cc-1m8g,
  .crisp-client .cc-unoo,
  .crisp-client [data-is-launcher-hidden="true"],
  .crisp-client [data-chat-status="closed"] {
    display: none !important;
    visibility: hidden !important;
    opacity: 0 !important;
    pointer-events: none !important;
  }
</style>

<script>
  type CrispQueue = { push: (args: unknown[]) => void; is?: (state: string) => boolean };

  /** Crisp 脚本真正加载完成后，window.$crisp 会从占位数组变成带 is() 的对象 */
  function crispReady(): boolean {
    const c = (window as unknown as { $crisp?: CrispQueue }).$crisp;
    return !!c && !Array.isArray(c) && typeof c.is === 'function';
  }

  let fallbackTimer = 0;
  let readyPoll = 0;
  function hideFallback() {
    const box = document.getElementById('crisp-fallback');
    if (box) box.hidden = true;
    window.clearTimeout(fallbackTimer);
    window.clearInterval(readyPoll);
  }
  /** 脚本还没到：先提示「正在连接」，2.5 秒后仍未就绪就给出对话页和工单两个入口 */
  function showFallback() {
    const box = document.getElementById('crisp-fallback');
    if (!box) return;
    const title = box.querySelector<HTMLElement>('[data-crisp-fallback-title]');
    const text = box.querySelector<HTMLElement>('[data-crisp-fallback-text]');
    const actions = box.querySelector<HTMLElement>('[data-crisp-fallback-actions]');
    if (title) title.textContent = '正在连接在线客服…';
    if (text) text.hidden = true;
    if (actions) actions.hidden = true;
    box.hidden = false;
    window.clearTimeout(fallbackTimer);
    window.clearInterval(readyPoll);
    readyPoll = window.setInterval(() => { if (crispReady()) hideFallback(); }, 300);
    fallbackTimer = window.setTimeout(() => {
      if (crispReady()) return hideFallback();
      if (title) title.textContent = '在线客服暂时没有打开';
      if (text) text.hidden = false;
      if (actions) actions.hidden = false;
    }, 2500);
  }

  /** 打开 Crisp 对话；脚本还没加载出来时，命令先排队，同时给出其他联系方式 */
  function openCrisp(initialMessage?: string) {
    const crisp = (window as unknown as { $crisp?: CrispQueue }).$crisp;
    if (crisp && typeof crisp.push === 'function') {
      if (initialMessage && initialMessage.trim()) {
        crisp.push(['do', 'message:send', ['text', initialMessage.trim()]]);
      }
      crisp.push(['do', 'chat:show']);
      crisp.push(['do', 'chat:open']);
      if (crispReady()) return;
    }
    showFallback();
  }

  function toggleCrisp() {
    const crisp = (window as unknown as { $crisp?: CrispQueue }).$crisp;
    if (crispReady() && crisp && typeof crisp.is === 'function' && crisp.is('chat:opened')) {
      crisp.push(['do', 'chat:close']);
      crisp.push(['do', 'chat:hide']);
      return;
    }
    openCrisp();
  }

  function setupCrispLauncher() {
    (window as unknown as { ldyOpenCrisp?: typeof openCrisp }).ldyOpenCrisp = openCrisp;
    document.querySelector('[data-crisp-fallback-close]')?.addEventListener('click', hideFallback);

    const launcher = document.getElementById('crisp-custom-launcher');
    launcher?.addEventListener('click', toggleCrisp);
    launcher?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        toggleCrisp();
      }
    });

    // 页面里的「联系在线客服」大按钮出现在屏幕上时，右下角的悬浮按钮先让开，免得在手机上盖住它
    if (launcher && 'IntersectionObserver' in window) {
      const shown = new Set<Element>();
      const io = new IntersectionObserver((entries) => {
        entries.forEach((en) => (en.isIntersecting ? shown.add(en.target) : shown.delete(en.target)));
        launcher.classList.toggle('is-quiet', shown.size > 0);
      }, { threshold: 0.01 });
      document.querySelectorAll<HTMLElement>('[data-open-crisp]').forEach((el) => {
        if (el.id !== 'footer-crisp-btn') io.observe(el);
      });
    }

    // 页面上所有「联系在线客服」按钮
    document.querySelectorAll<HTMLElement>('[data-open-crisp]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        openCrisp();
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupCrispLauncher);
  } else {
    setupCrispLauncher();
  }
</script>
