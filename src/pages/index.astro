---
// index.astro: 灵动云帮助中心首页
// 结构：Hero（搜索 / 在线客服 / 排查步骤）→ 按问题找答案 → 在线客服与工单 → 网络知识 → 套餐与购买 → 官方站点 → 常见问题
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroEmblem from '../components/HeroEmblem.astro';
import Icon from '../components/Icon.astro';
import GuidesSection from '../components/GuidesSection.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import FeedbackSection from '../components/FeedbackSection.astro';
import FamilyBlock from '../components/FamilyBlock.astro';
import { SITE_CONFIG } from '../config/site';
import { FAQS_DATA } from '../data/faqs';
import { PLANS_DATA, summarizePlans } from '../data/plans';

const problems = [
  {
    title: '节点连不上',
    text: '全部节点超时，或者显示已连接却打不开网页。',
    href: '/guides/troubleshooting/#timeout',
    icon: 'unplug',
  },
  {
    title: '订阅更新失败',
    text: '更新时报错、节点列表为空，或导入时提示格式错误。',
    href: '/guides/troubleshooting/#update-failed',
    icon: 'refresh-alert',
  },
  {
    title: '速度慢或不稳定',
    text: '晚上明显变慢、视频频繁缓冲、延迟忽高忽低。',
    href: '/guides/troubleshooting/#slow',
    icon: 'gauge',
  },
  {
    title: '流量用完或到期',
    text: '提示流量不足，或者套餐到期后节点全部失效。',
    href: '/guides/troubleshooting/#quota',
    icon: 'battery-low',
  },
  {
    title: '账户与订阅链接安全',
    text: '订阅链接发给了别人、流量消耗异常，应该怎么处理。',
    href: '/guides/network-security/',
    icon: 'shield-key',
  },
  {
    title: '访问 AI 与流媒体',
    text: 'ChatGPT、Claude 提示地区不可用，或流媒体播放报错。',
    href: '/guides/ai-network/',
    icon: 'sparkle-play',
  },
] as const;

const planSummary = summarizePlans();

const faqSchema = {
  '@type': 'FAQPage',
  '@id': `${SITE_CONFIG.siteUrl}/#faq`,
  mainEntity: FAQS_DATA.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<BaseLayout
  title="灵动云帮助中心｜连接问题排查、网络知识与在线客服"
  description={SITE_CONFIG.description}
  canonicalPath="/"
  jsonLd={[faqSchema]}
>
  <!-- Hero：盾牌徽记 + 大搜索框（主操作）+ 在线客服（次操作）+ 排查步骤（文字链接） -->
  <section class="hero">
    <div class="wrap">
      <HeroEmblem />

      <div class="mx-auto max-w-3xl">
        <div class="badge">
          <Icon name="shield-check" />
          <span>灵动云官方帮助中心 · HELP CENTER</span>
        </div>

        <h1 class="hero-title mt-5">灵动云帮助中心</h1>
        <p class="hero-tagline">连不上、更新失败、速度慢，先在这里找答案。</p>

        <p class="hero-intro">
          这里整理了灵动云常见连接问题的排查步骤，线路、代理模式和账户安全等网络知识，以及在线客服入口。先搜索你遇到的问题；照着步骤仍然解决不了，可以直接联系在线客服。
        </p>

        <!-- Primary: search -->
        <button type="button" data-open-search class="hero-search" aria-label="搜索帮助中心">
          <Icon name="search" class="hero-search-icon" />
          <span class="hero-search-text">搜索问题，例如：订阅更新失败</span>
          <kbd class="kbd hidden md:inline-flex" data-kbd>⌘K</kbd>
          <span class="hero-search-go hidden sm:inline-flex">搜索</span>
        </button>

        <div class="hero-actions">
          <button type="button" data-open-crisp class="btn btn-secondary btn-lg w-full sm:w-auto">
            <Icon name="chat" />
            <span>联系在线客服</span>
          </button>
          <a href="/guides/troubleshooting/" class="text-action">
            <span>节点连不上？查看排查步骤</span>
            <Icon name="arrow-right" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 按问题找答案 -->
  <section id="problems" class="section">
    <div class="wrap">
      <div class="section-head">
        <h2 class="section-title">按问题找答案</h2>
        <p class="section-lead">选一项最接近你现在情况的，直接跳到对应的检查步骤或说明。</p>
      </div>

      <ul class="problem-grid" role="list">
        {problems.map((item) => (
          <li>
            <a href={item.href} class="problem-card glass">
              <span class="icon-tile">
                <Icon name={item.icon} />
              </span>
              <span class="problem-title">{item.title}</span>
              <span class="problem-text">{item.text}</span>
              <span class="more">
                <span>查看处理办法</span>
                <Icon name="arrow-right" />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 在线客服与工单 -->
  <FeedbackSection />

  <!-- 网络知识 -->
  <GuidesSection />

  <!-- 套餐与购买（小卡片：详细对比去套餐选择站，完整价格去官网说明页） -->
  <section id="plans" class="relative py-6 sm:py-8">
    <div class="wrap">
      <div class="glass rounded-panel grid gap-8 p-6 sm:p-8 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] lg:items-center lg:gap-12 lg:p-10">
        <div>
          <div class="flex items-center gap-3">
            <span class="icon-tile icon-tile-sm"><Icon name="layers" /></span>
            <h2 class="text-xl font-semibold leading-snug text-ink sm:text-2xl">套餐与购买</h2>
          </div>
          <p class="mt-4 text-[0.9375rem] leading-[1.85] text-ink-2">
            灵动云共有 {PLANS_DATA.length} 档套餐，所有套餐不限速、不限设备数量。帮助中心不做套餐推荐：想按用途比较、估算每月流量，请到套餐选择站；完整的价格与计费规则见官网说明页。
          </p>
          <ul class="mt-5 grid grid-cols-2 gap-2.5" role="list">
            {planSummary.map((g) => (
              <li class="plan-tile">
                <span class="block text-[0.9375rem] font-semibold text-ink"><span class="keep-words">{g.label}</span>{g.count > 1 && <Fragment>{' '}<span class="whitespace-nowrap">{`${g.count} 档`}</span></Fragment>}</span>
                <span class="mt-0.5 block text-sm text-lilac-soft tabular-nums">{g.count > 1 && !g.fromPrice.endsWith('起') ? `${g.fromPrice} 起` : g.fromPrice}</span>
              </li>
            ))}
          </ul>
          <p class="mt-4 text-[0.8125rem] text-ink-3">价格以用户中心实时显示为准。</p>
        </div>
        <div class="flex flex-col gap-2.5">
          <a href="https://lingdongyun.best/" class="btn btn-secondary link-row">
            <span>按用途选套餐、估算流量</span><Icon name="arrow-right" />
          </a>
          <a href="https://lingdongyun.site/guides/plan-selection/" class="btn btn-secondary link-row">
            <span>官网：套餐价格与服务说明</span><Icon name="arrow-right" />
          </a>
          <a href={SITE_CONFIG.registerUrl} target="_blank" rel="noopener" class="btn btn-primary link-row">
            <span>注册并购买</span><Icon name="external" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 官方站点 -->
  <FamilyBlock />

  <!-- 常见问题 -->
  <FaqAccordion />
</BaseLayout>
